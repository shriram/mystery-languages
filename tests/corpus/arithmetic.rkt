#lang mystery-languages/arithmetic

;; syntax coverage; every form has the same value in every variant
(defvar x 3)
(TEST x 3 3 3)
(+ 1 2 3)
(TEST (+ 1 2 3) 6 6 6)
(TEST (- 10 4 3) 3 3 3)
(TEST (* 2 3 4) 24 24 24)
(TEST (+ 1 (* 2 3)) 7 7 7)
(TEST (* (+ 1 2) 3) 9 9 9)
(TEST (- (+ 1 2) 3) 0 0 0)
(TEST (+ (- 1 2) 3) 2 2 2)
(TEST (- x) -3 -3 -3)
(TEST (- x 5) -2 -2 -2)
(TEST (< 1 2 3) #t #t #t)
(TEST (<= 2 2) #true #true #true)
(TEST (> 3 2) #t #t #t)
(TEST (>= 2 3) #f #f #f)
(TEST (= x 3) #t #t #t)
(TEST (<> x 3) #f #f #f)
(TEST (+ 1 "a") failure failure failure)
(TEST (++ "a" "b" "c") "abc" "abc" "abc")
(TEST (- 5) -5 -5 -5)
(TEST (* -1 x) -3 -3 -3)
(TEST (+ 1 -2) -1 -1 -1)
(TEST (< (+ 1 2) (* 2 2)) #t #t #t)
(TEST (+ 1 2) number number number)
(TEST (+ 1 2) (not 4) (not 4) (not 4))
(TEST "hi" string string string)
(TEST (= 1 1) boolean boolean boolean)
(TEST (- -2) 2 2 2)
(TEST (* 2 (- 3 1) 4) 16 16 16)
