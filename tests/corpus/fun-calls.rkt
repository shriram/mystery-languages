#lang mystery-languages/fun-calls

(deffun (f) 3)
(deffun (g x) (+ x x))
(deffun (h x y z) (++ x y z))
(TEST (f) 3 3 3)
(TEST (g 5) 10 10 10)
(TEST (h "a" "b" "c") "abc" "abc" "abc")
(deffun (twice x) (+ x x))
(TEST (twice 3) 6 6 6)
(defvar z 10)
(deffun (addz x) (+ x z))
(TEST (addz 1) 11 11 11)
(TEST (g "a") failure failure failure)
(TEST (f 1) failure failure failure)
(deffun (choose c a b) (if c a b))
(TEST (choose (< 1 2) "yes" "no") "yes" "yes" "yes")
(deffun (max2 a b) (if (> a b) a b))
(TEST (max2 1 5) 5 5 5)
(TEST (twice 1) number number number)
