#lang mystery-languages/conditionals

(TEST (if #t 1 2) 1 1 1)
(TEST (if #f 1 2) 2 2 2)
(TEST (and #t #f) #f #f #f)
(TEST (or #f #t) #t #t #t)
(TEST (not #t) #f #f #f)
(TEST (and #t #t #t) #t #t #t)
(TEST (or #f #f #t) #t #t #t)
(TEST (if (< 1 2) (+ 1 1) (+ 2 2)) 2 2 2)
(TEST (if (not (= 1 2)) "y" "n") "y" "y" "y")
(TEST (or (< 2 1) (and #t (> 3 2))) #t #t #t)
(defvar y (if #t 10 20))
(TEST y 10 10 10)
(TEST (if #t (if #f 1 2) 3) 2 2 2)
(TEST (not (not #t)) #t #t #t)
(TEST (and (not #f) (< 1 2)) #t #t #t)
(TEST (if (and #t (or #f #t)) (- 0 1) 1) -1 -1 -1)
(TEST (+ (if #t 1 2) 10) 11 11 11)
(TEST (if (if #t #f #t) 1 2) 2 2 2)
(TEST (if (< 1 2) "less" "not") "less" "less" "less")
