#lang mystery-languages/mut-vars

(defvar v 3)
(set! v 4)
(TEST v 4 4 4)
(TEST (begin 1 2 3) 3 3 3)
(TEST (begin (set! v 100) v) 100 100 100)
(deffun (inc x) (begin (set! x (+ x 1)) x))
(TEST (inc 7) 8 8 8)
(deffun (two x y) (begin (set! x 1) (set! y 2) (+ x y)))
(TEST (two 5 6) 3 3 3)
(set! v (+ v 1))
(TEST (if (= v 101) "one" "other") "one" "one" "one")
(defvar w 0)
(begin (set! w 1) (set! w (+ w 1)))
(TEST w 2 2 2)
(deffun (bump) (begin (set! w (+ w 10)) w))
(TEST (bump) 12 12 12)
(TEST w 12 12 12)
(TEST (set! v 5) void void void)
